{
    "name": "studente/delivery-project",
    "description": "Progetto universitario basato su architettura MVC e Doctrine",
    "type": "project",

    "require": {
        "php": ">=8.0",
        "doctrine/orm": "2.19",
        "doctrine/dbal": "^3.0",
        "smarty/smarty": "5.8",
        "symfony/cache": "^7.4"
    },

    "autoload": {
        "psr-4": {
            "TableCrown\\Entity\\": "Entity/",
            "TableCrown\\Control\\": "Control/",
            "TableCrown\\Presentation\\": "Presentation/",
            "TableCrown\\Foundation\\": "Foundation/",
            "TableCrown\\Utility\\": "Utility/"
        }
    },
    "require-dev": {
        "doctrine/data-fixtures": "^2.2",
        "fakerphp/faker": "^1.24"
    }
}
