<IfModule mod_rewrite.c>
RewriteEngine On
RewriteBase /

#Se la richiesta è un file o una cartella vera (es. i CSS, le immagini di Presentation, ecc.), servila direttamente
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

#Altrimenti, manda tutto a index.php centrale
RewriteRule ^(.*)$ index.php?url=$1 [QSA,L]

#Protezione di sicurezza
<FilesMatch "^\.">
Order Allow,Deny
Deny from all
</FilesMatch>

</IfModule>